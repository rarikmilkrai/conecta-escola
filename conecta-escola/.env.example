# Copie para .env e ajuste. Nenhum valor aqui é obrigatório.

# Porta no notebook (o site abre em http://IP-DO-NOTEBOOK:8080)
APP_PORT=8080

# Login do administrador criado na primeira vez que o sistema sobe
ADMIN_EMAIL=admin@conectaescola.local
ADMIN_PASSWORD=troque-esta-senha

# Escola(s) criadas na primeira subida (separe várias com ;)
SCHOOLS=E.E VILA SÃO JOAQUIM II
SCHOOL_CITY=Cotia

# Endereço usado no QR Code. Se vazio, o QR usa o endereço por onde a página /qr foi aberta.
# Ex.: PUBLIC_URL=http://192.168.0.10:8080  ou  https://xxxx.trycloudflare.com
PUBLIC_URL=

# Deixe true só se o site estiver em HTTPS (ex.: usando o tunnel)
COOKIE_SECURE=false
